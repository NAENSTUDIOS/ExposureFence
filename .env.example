# ExposureFence Environment Configuration Template
# Copy this file to .env and configure for your AWS deployment.

# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AGENTCORE_HARNESS_ARN=
AGENTCORE_EXECUTION_ROLE_ARN=

# Bedrock Model Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Security Console Admin Authentication
# Default dev password: "ExposureFenceAdmin2026!"
# Generate production hash with: python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt()).decode())"
APPROVER_PASSWORD_HASH=

# Local Server Binding (Bound strictly to localhost)
HOST=127.0.0.1
PORT=8000
