# ExposureFence Environment Configuration Template
# Copy this file to .env and configure for your environment.

# Operational Data Mode: 'mock' (default) or 'aws' (read-only inspection)
# In 'mock' mode, evaluates cryptographically hashed local fixtures without AWS calls.
# In 'aws' mode, uses read-only Boto3 connectors (S3, EC2, IAM) without making mutations.
EXPOSUREFENCE_DATA_MODE=mock

# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AGENTCORE_HARNESS_ARN=
AGENTCORE_EXECUTION_ROLE_ARN=

# Bedrock Model Configuration
# Recommended active ultra-low-cost model supporting ConverseStream and Tool Use:
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Supported Alternatives:
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# Security Console Admin Authentication
APPROVER_USERNAME=admin
# Required: Bcrypt hash of the admin password. Authentication is strictly disabled if unset.
# Generate hash with: python -c "import bcrypt; print(bcrypt.hashpw(b'YourPasswordHere', bcrypt.gensalt()).decode())"
APPROVER_PASSWORD_HASH=

# Local Server Binding (Bound strictly to localhost)
HOST=127.0.0.1
PORT=8000
